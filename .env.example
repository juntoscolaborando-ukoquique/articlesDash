# Credencial de administrador de kilombo.top
# Es la contraseña del usuario "kilombo" en el panel YunoHost / SPIP.
# Copiar este archivo como .env y rellenar el valor real.
KILOMBOTOP_PASSWORD=tu-contraseña-aqui

# Contraseña alternativa durante rotación de credenciales (opcional).
# Se usa cuando KILOMBOTOP_PASSWORD no está definida o está vacía.
# No es un fallback automático si la contraseña principal falla en el login —
# para eso hay que cambiar KILOMBOTOP_PASSWORD directamente.
# KILOMBOTOP_FUTURE_PASSWORD=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Espejo de respaldo. Fuente de verdad: GitLab (ver abajo).
# Repositorio donde vive este código. Formato: propietario/nombre-repo
# Ejemplo: miusuario/articulos-ready
GITHUB_REPOSITORY=

# Token clásico de GitHub (ghp_...) con al menos scope "repo" (lectura/escritura).
# Generar en: https://github.com/settings/tokens → Generate new token (classic)
GITHUB_TOKEN=

# ── GitLab ────────────────────────────────────────────────────────────────────
# Repositorio principal — GitLab es la fuente de verdad; GitHub es el backup.
# Formato: propietario/nombre-repo (o grupo/subgrupo/repo)
# Ejemplo: miusuario/articulos-ready  (gitlab.com se asume por defecto)
GITLAB_REPOSITORY=
# Personal Access Token de GitLab con scope "write_repository".
# Generar en: https://gitlab.com/-/user_settings/personal_access_tokens
GITLAB_TOKEN=

# ID numérico del proyecto en GitLab (visible en Settings → General, debajo del nombre).
# No es necesario para git push, pero sí para llamadas a la API REST/GraphQL
# (pipelines, issues, CI artifacts, etc.).
GITLAB_PROJECT_ID=

# ── Groq AI ───────────────────────────────────────────────────────────────────
# Clave de API para Groq (https://console.groq.com/keys).
# Necesaria para la Etapa 4 — IA pipeline (ver ROADMAP.md).
# No es necesaria para las Etapas 1–3.
GROQ_API_KEY=
